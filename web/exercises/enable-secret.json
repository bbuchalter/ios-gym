{
  "id": "enable-secret",
  "description": "Configure hostname and enable secret password",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "hostname CorporateSwitch",
    "enable secret C1sc0R0ck$",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "hostname",
        "expected": "CorporateSwitch",
        "message": "Hostname should be CorporateSwitch"
      },
      {
        "type": "enable_secret",
        "message": "Enable secret password should be configured"
      }
    ]
  }
}

