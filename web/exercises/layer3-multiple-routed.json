{
  "id": "layer3-multiple-routed",
  "description": "Configure multiple routed ports for point-to-point links (simplified for 2960 hardware)",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "hostname CorporateDistributionSwitch1",
    "interface g0/1",
    "no switchport",
    "ip address 35.72.15.2 255.255.255.252",
    "no shutdown",
    "exit",
    "interface g0/2",
    "no switchport",
    "ip address 35.72.15.6 255.255.255.252",
    "no shutdown",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "hostname",
        "expected": "CorporateDistributionSwitch1",
        "message": "Hostname should be CorporateDistributionSwitch1"
      },
      {
        "type": "interface_mode",
        "interface": "g0/1",
        "expected": "routed",
        "message": "GigabitEthernet 0/1 should be a routed port"
      },
      {
        "type": "interface_ip",
        "interface": "g0/1",
        "ip": "35.72.15.2",
        "mask": "255.255.255.252",
        "message": "GigabitEthernet 0/1 should have IP 35.72.15.2/30"
      },
      {
        "type": "interface_admin_up",
        "interface": "g0/1",
        "expected": true,
        "message": "GigabitEthernet 0/1 should be enabled"
      },
      {
        "type": "interface_mode",
        "interface": "g0/2",
        "expected": "routed",
        "message": "GigabitEthernet 0/2 should be a routed port"
      },
      {
        "type": "interface_ip",
        "interface": "g0/2",
        "ip": "35.72.15.6",
        "mask": "255.255.255.252",
        "message": "GigabitEthernet 0/2 should have IP 35.72.15.6/30"
      },
      {
        "type": "interface_admin_up",
        "interface": "g0/2",
        "expected": true,
        "message": "GigabitEthernet 0/2 should be enabled"
      }
    ]
  }
}
