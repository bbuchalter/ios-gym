{
  "id": "management-access",
  "description": "Configure management access with VLAN 1 IP address and default gateway",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "interface vlan 1",
    "ip address 192.168.1.100 255.255.255.0",
    "no shutdown",
    "exit",
    "ip default-gateway 192.168.1.1",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "interface_ip",
        "interface": "vlan1",
        "ip": "192.168.1.100",
        "mask": "255.255.255.0",
        "message": "VLAN 1 interface should have IP address 192.168.1.100/24"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan1",
        "expected": true,
        "message": "VLAN 1 interface should be enabled (did you use 'no shutdown'?)"
      },
      {
        "type": "default_gateway",
        "expected": "192.168.1.1",
        "message": "Default gateway should be set to 192.168.1.1"
      }
    ]
  }
}
