{
  "id": "static-routing",
  "description": "Configure primary default route with floating backup using administrative distance",
  "deviceModel": "1941-router",
  "commands": [
    "enable",
    "configure terminal",
    "ip route 0.0.0.0 0.0.0.0 35.72.13.1",
    "ip route 0.0.0.0 0.0.0.0 35.72.13.2 254",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "route_exists",
        "dest": "0.0.0.0",
        "mask": "0.0.0.0",
        "nextHop": "35.72.13.1",
        "ad": 1,
        "message": "Primary default route via 35.72.13.1 with AD 1 should exist"
      },
      {
        "type": "route_exists",
        "dest": "0.0.0.0",
        "mask": "0.0.0.0",
        "nextHop": "35.72.13.2",
        "ad": 254,
        "message": "Floating backup route via 35.72.13.2 with AD 254 should exist"
      }
    ]
  }
}

