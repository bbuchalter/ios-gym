{
  "id": "capstone-full-network",
  "description": "Complete Layer 3 switch configuration - simplified for 2960 hardware (2 routed ports instead of 4)",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "hostname CorporateDistributionSwitch1",
    "vlan 100",
    "exit",
    "vlan 200",
    "exit",
    "interface vlan 1",
    "ip address 172.16.16.1 255.255.255.0",
    "no shutdown",
    "exit",
    "interface vlan 100",
    "ip address 35.72.10.1 255.255.255.0",
    "no shutdown",
    "exit",
    "interface vlan 200",
    "ip address 33.2.169.1 255.255.255.0",
    "no shutdown",
    "exit",
    "interface g0/1",
    "no switchport",
    "ip address 35.72.15.2 255.255.255.252",
    "no shutdown",
    "ip ospf cost 10",
    "exit",
    "interface g0/2",
    "no switchport",
    "ip address 35.72.15.6 255.255.255.252",
    "no shutdown",
    "ip ospf cost 30",
    "exit",
    "router ospf 1",
    "network 35.72.15.2 0.0.0.0 area 0",
    "network 35.72.15.6 0.0.0.0 area 0",
    "network 172.16.16.1 0.0.0.0 area 0",
    "network 35.72.10.1 0.0.0.0 area 0",
    "network 33.2.169.1 0.0.0.0 area 0",
    "exit",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "hostname",
        "expected": "CorporateDistributionSwitch1",
        "message": "Hostname should be CorporateDistributionSwitch1"
      },
      {
        "type": "vlan_exists",
        "vlanId": "100",
        "message": "VLAN 100 should exist"
      },
      {
        "type": "vlan_exists",
        "vlanId": "200",
        "message": "VLAN 200 should exist"
      },
      {
        "type": "interface_ip",
        "interface": "vlan1",
        "ip": "172.16.16.1",
        "mask": "255.255.255.0",
        "message": "VLAN 1 SVI should have management IP 172.16.16.1/24"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan1",
        "expected": true,
        "message": "VLAN 1 SVI should be enabled"
      },
      {
        "type": "interface_ip",
        "interface": "vlan100",
        "ip": "35.72.10.1",
        "mask": "255.255.255.0",
        "message": "VLAN 100 SVI should have IP 35.72.10.1/24 for student network"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan100",
        "expected": true,
        "message": "VLAN 100 SVI should be enabled"
      },
      {
        "type": "interface_ip",
        "interface": "vlan200",
        "ip": "33.2.169.1",
        "mask": "255.255.255.0",
        "message": "VLAN 200 SVI should have IP 33.2.169.1/24 for teacher network"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan200",
        "expected": true,
        "message": "VLAN 200 SVI should be enabled"
      },
      {
        "type": "interface_mode",
        "interface": "g0/1",
        "expected": "routed",
        "message": "GigabitEthernet 0/1 should be a routed port (primary uplink)"
      },
      {
        "type": "interface_ip",
        "interface": "g0/1",
        "ip": "35.72.15.2",
        "mask": "255.255.255.252",
        "message": "GigabitEthernet 0/1 should have IP 35.72.15.2/30"
      },
      {
        "type": "interface_admin_up",
        "interface": "g0/1",
        "expected": true,
        "message": "GigabitEthernet 0/1 should be enabled"
      },
      {
        "type": "interface_mode",
        "interface": "g0/2",
        "expected": "routed",
        "message": "GigabitEthernet 0/2 should be a routed port (backup uplink)"
      },
      {
        "type": "interface_ip",
        "interface": "g0/2",
        "ip": "35.72.15.6",
        "mask": "255.255.255.252",
        "message": "GigabitEthernet 0/2 should have IP 35.72.15.6/30"
      },
      {
        "type": "interface_admin_up",
        "interface": "g0/2",
        "expected": true,
        "message": "GigabitEthernet 0/2 should be enabled"
      },
      {
        "type": "ospf_interface_cost",
        "interface": "g0/1",
        "expected": 10,
        "message": "GigabitEthernet 0/1 should have OSPF cost 10 (preferred primary path)"
      },
      {
        "type": "ospf_interface_cost",
        "interface": "g0/2",
        "expected": 30,
        "message": "GigabitEthernet 0/2 should have OSPF cost 30 (backup path)"
      },
      {
        "type": "ospf_network",
        "ip": "35.72.15.2",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 35.72.15.2 (g0/1)"
      },
      {
        "type": "ospf_network",
        "ip": "35.72.15.6",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 35.72.15.6 (g0/2)"
      },
      {
        "type": "ospf_network",
        "ip": "172.16.16.1",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 172.16.16.1 (VLAN 1)"
      },
      {
        "type": "ospf_network",
        "ip": "35.72.10.1",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 35.72.10.1 (VLAN 100)"
      },
      {
        "type": "ospf_network",
        "ip": "33.2.169.1",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 33.2.169.1 (VLAN 200)"
      }
    ]
  }
}
