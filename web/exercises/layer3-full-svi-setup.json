{
  "id": "layer3-full-svi-setup",
  "description": "Complete Layer 3 switch setup with management and VLAN SVIs",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "hostname CorporateDistributionSwitch1",
    "vlan 100",
    "exit",
    "vlan 200",
    "exit",
    "interface vlan 1",
    "ip address 172.16.16.1 255.255.255.0",
    "no shutdown",
    "exit",
    "interface vlan 100",
    "ip address 35.72.10.1 255.255.255.0",
    "no shutdown",
    "exit",
    "interface vlan 200",
    "ip address 33.2.169.1 255.255.255.0",
    "no shutdown",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "hostname",
        "expected": "CorporateDistributionSwitch1",
        "message": "Hostname should be CorporateDistributionSwitch1"
      },
      {
        "type": "vlan_exists",
        "vlanId": "100",
        "message": "VLAN 100 should exist"
      },
      {
        "type": "vlan_exists",
        "vlanId": "200",
        "message": "VLAN 200 should exist"
      },
      {
        "type": "interface_ip",
        "interface": "vlan1",
        "ip": "172.16.16.1",
        "mask": "255.255.255.0",
        "message": "VLAN 1 SVI should have IP 172.16.16.1/24 for management"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan1",
        "expected": true,
        "message": "VLAN 1 SVI should be enabled"
      },
      {
        "type": "interface_ip",
        "interface": "vlan100",
        "ip": "35.72.10.1",
        "mask": "255.255.255.0",
        "message": "VLAN 100 SVI should have IP 35.72.10.1/24 for student network"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan100",
        "expected": true,
        "message": "VLAN 100 SVI should be enabled"
      },
      {
        "type": "interface_ip",
        "interface": "vlan200",
        "ip": "33.2.169.1",
        "mask": "255.255.255.0",
        "message": "VLAN 200 SVI should have IP 33.2.169.1/24 for teacher network"
      },
      {
        "type": "interface_admin_up",
        "interface": "vlan200",
        "expected": true,
        "message": "VLAN 200 SVI should be enabled"
      }
    ]
  }
}

