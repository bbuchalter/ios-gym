{
  "id": "logging-synchronous",
  "description": "Configure logging synchronous on console line",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "interface vlan 1",
    "end",
    "configure terminal",
    "line console 0",
    "logging synchronous",
    "end"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "command_succeeded",
        "message": "Logging synchronous configuration should complete without errors"
      }
    ]
  }
}

