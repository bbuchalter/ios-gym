{
  "id": "trunk-restricted",
  "description": "Configure trunk ports with restricted VLAN list for security",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "interface g0/1",
    "switchport mode trunk",
    "switchport trunk allowed vlan 1,100,200",
    "exit",
    "interface fa0/1",
    "switchport mode trunk",
    "switchport trunk allowed vlan 1,100,200",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "interface_mode",
        "interface": "g0/1",
        "expected": "trunk",
        "message": "GigabitEthernet 0/1 should be configured as a trunk port"
      },
      {
        "type": "interface_trunk_allowed",
        "interface": "g0/1",
        "expected": "1,100,200",
        "message": "GigabitEthernet 0/1 should allow only VLANs 1,100,200"
      },
      {
        "type": "interface_mode",
        "interface": "fa0/1",
        "expected": "trunk",
        "message": "FastEthernet 0/1 should be configured as a trunk port"
      },
      {
        "type": "interface_trunk_allowed",
        "interface": "fa0/1",
        "expected": "1,100,200",
        "message": "FastEthernet 0/1 should allow only VLANs 1,100,200"
      }
    ]
  }
}

