{
  "id": "no-command-lifecycle",
  "description": "Practice configuration lifecycle - set, verify, then remove configuration",
  "deviceModel": "2960-switch",
  "commands": [
    "enable",
    "configure terminal",
    "hostname TestLab",
    "enable secret Practice123",
    "end",
    "disable",
    "enable",
    "configure terminal",
    "no enable secret",
    "no hostname",
    "end",
    "disable",
    "enable",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "hostname",
        "expected": "Switch",
        "message": "Hostname should be reset to default 'Switch' after using 'no hostname'"
      }
    ]
  }
}
