{
  "id": "ospf-basic",
  "description": "Configure basic OSPF to advertise a single network",
  "deviceModel": "1941-router",
  "commands": [
    "enable",
    "configure terminal",
    "router ospf 1",
    "network 35.72.12.2 0.0.0.0 area 0",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "ospf_network",
        "ip": "35.72.12.2",
        "wildcard": "0.0.0.0",
        "area": 0,
        "message": "OSPF should advertise network 35.72.12.2 in area 0"
      }
    ]
  }
}

