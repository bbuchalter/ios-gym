{
  "id": "ospf-cost",
  "description": "Configure OSPF interface costs to control path preference",
  "deviceModel": "1941-router",
  "commands": [
    "enable",
    "configure terminal",
    "interface g0/0",
    "ip ospf cost 10",
    "exit",
    "interface g0/1",
    "ip ospf cost 30",
    "end",
    "write memory"
  ],
  "validation": {
    "type": "goal-based",
    "assertions": [
      {
        "type": "ospf_interface_cost",
        "interface": "g0/0",
        "expected": 10,
        "message": "GigabitEthernet 0/0 should have OSPF cost 10 (primary path)"
      },
      {
        "type": "ospf_interface_cost",
        "interface": "g0/1",
        "expected": 30,
        "message": "GigabitEthernet 0/1 should have OSPF cost 30 (backup path)"
      }
    ]
  }
}

