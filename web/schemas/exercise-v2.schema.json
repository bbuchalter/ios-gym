{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ios-practice.local/schemas/exercise-v2.schema.json",
  "title": "Exercise Definition v2 - Hierarchical Goals",
  "description": "Schema for IOS CLI practice exercises with goal-oriented structure supporting both 'show commands' and 'objectives only' modes",
  "type": "object",
  "required": ["id", "deviceModel", "goals", "validation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "deviceModel": {
      "type": "string",
      "enum": ["2960-switch", "1941-router"]
    },
    "description": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/goalSection"
      }
    },
    "validation": {
      "type": "object",
      "required": ["type", "assertions"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["goal-based", "exploratory"]
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/assertion"
          }
        }
      }
    }
  },
  "definitions": {
    "goalSection": {
      "type": "object",
      "required": ["title", "steps"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Section title (e.g., 'Configure Routed Port')"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["objective", "command"],
      "properties": {
        "objective": {
          "type": "string",
          "description": "What this command accomplishes"
        },
        "command": {
          "type": "string",
          "description": "The IOS command to execute"
        },
        "teachingPoint": {
          "type": "string",
          "description": "Educational explanation of why/how this command works"
        },
        "keyCommand": {
          "type": "boolean",
          "description": "Mark as a critical command to emphasize"
        },
        "critical": {
          "type": "boolean",
          "description": "Mark as critical (e.g., write memory)"
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "interface_exists",
            "interface_ip",
            "interface_mode",
            "interface_admin_up",
            "hostname",
            "vlan_exists",
            "vlan_name",
            "interface_access_vlan",
            "interface_trunk_allowed",
            "ospf_network",
            "ospf_interface_cost",
            "route_exists",
            "ssh_domain",
            "ssh_version",
            "ssh_user",
            "vty_config",
            "enable_secret",
            "default_gateway",
            "mode_reached",
            "command_succeeded",
            "ip_routing_enabled",
            "config_saved"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
