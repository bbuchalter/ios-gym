{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./public",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["client/**/*.ts", "src/cli/**/*.ts", "src/exercise/**/*.ts", "src/types.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/__tests__", "src/server", "src/grammar"]
}
