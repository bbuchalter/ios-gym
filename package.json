{
  "name": "ios-cli-trainer",
  "version": "1.0.0",
  "description": "Web-based Cisco IOS CLI typing trainer",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "echo 'No root build needed - use npm run web:build'",
    "test": "./node_modules/.bin/jest",
    "test:watch": "./node_modules/.bin/jest --watch",
    "test:coverage": "./node_modules/.bin/jest --coverage",
    "build:grammar": "node -e \"const yaml = require('js-yaml'); const fs = require('fs'); const commands = yaml.load(fs.readFileSync('commands.yaml', 'utf8')); fs.writeFileSync('web/public/commands.json', JSON.stringify(commands, null, 2));\"",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:start": "cd web && npm start"
  },
  "keywords": [
    "cisco",
    "ios",
    "cli",
    "training"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "optionalDependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^29.7.0",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
