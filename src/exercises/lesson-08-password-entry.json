{
  "id": "lesson-08-password-entry",
  "title": "Understanding Password Entry in IOS",
  "deviceModel": "2960-switch",
  "goals": [
    {
      "section": "Practice Password Entry",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter configuration mode",
          "command": "configure terminal"
        },
        {
          "objective": "Set enable secret password to 'C1sc0R0ck$'",
          "command": "enable secret C1sc0R0ck$",
          "teachingPoint": "This sets the password you'll practice entering with no visual feedback"
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end"
        },
        {
          "objective": "Return to user mode",
          "command": "disable"
        },
        {
          "objective": "Try to enter privileged mode",
          "command": "enable",
          "teachingPoint": "You'll be prompted for the password"
        },
        {
          "objective": "Type the password 'C1sc0R0ck$' carefully",
          "teachingPoint": "You won't see anything as you type - this is normal! Press ENTER when done"
        },
        {
          "objective": "Verify successful login",
          "teachingPoint": "If you see the # prompt, you typed it correctly!"
        },
        {
          "objective": "Return to user mode again",
          "command": "disable"
        },
        {
          "objective": "Try entering a wrong password",
          "command": "enable",
          "teachingPoint": "Deliberately type the wrong password to see the error message"
        },
        {
          "objective": "See the '% Bad secrets' message after 3 failed attempts"
        },
        {
          "objective": "Try again with correct password",
          "command": "enable"
        },
        {
          "objective": "Enter 'C1sc0R0ck$' correctly this time"
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "enableSecret",
      "expectedValue": "C1sc0R0ck$",
      "description": "Enable secret should be set to 'C1sc0R0ck$'",
      "diagnosticCommand": "show running-config"
    }
  ]
}

