{
  "id": "lesson-02-setting-enable-secret-password",
  "title": "Setting Enable Secret Password",
  "deviceModel": "2960-switch",
  "goals": [
    {
      "section": "Configure Security",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter global configuration mode",
          "command": "configure terminal"
        },
        {
          "objective": "Set enable secret password to 'cisco'",
          "command": "enable secret cisco",
          "teachingPoint": "The enable secret is encrypted and protects access to privileged mode. Always use strong passwords in production!"
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end"
        },
        {
          "objective": "Save configuration to memory",
          "command": "write memory"
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "enableSecret",
      "expectedValue": "cisco",
      "description": "Enable secret should be set to 'cisco'",
      "diagnosticCommand": "show running-config"
    }
  ]
}

