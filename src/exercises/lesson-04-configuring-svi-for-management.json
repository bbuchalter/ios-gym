{
  "id": "lesson-04-configuring-svi-for-management",
  "title": "Configuring SVI for Management",
  "deviceModel": "2960-switch",
  "goals": [
    {
      "section": "Configure Management Interface",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter global configuration mode",
          "command": "configure terminal"
        },
        {
          "objective": "Enter VLAN 1 interface configuration",
          "command": "interface vlan 1",
          "teachingPoint": "VLAN 1 is the default management VLAN. This SVI (Switch Virtual Interface) allows remote management."
        },
        {
          "objective": "Set IP address to 192.168.1.10 with subnet mask 255.255.255.0",
          "command": "ip address 192.168.1.10 255.255.255.0"
        },
        {
          "objective": "Enable the interface",
          "command": "no shutdown",
          "teachingPoint": "Interfaces are administratively down by default. 'no shutdown' brings them up."
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end"
        },
        {
          "objective": "Save configuration",
          "command": "write memory"
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.ip",
      "expectedValue": "192.168.1.10",
      "description": "VLAN 1 should have IP address 192.168.1.10",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.mask",
      "expectedValue": "255.255.255.0",
      "description": "VLAN 1 should have subnet mask 255.255.255.0",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.adminUp",
      "expectedValue": true,
      "description": "VLAN 1 interface should be enabled (no shutdown)",
      "diagnosticCommand": "show ip interface brief"
    }
  ]
}

