{
  "id": "lesson-01-setting-hostname-and-saving-configuration",
  "title": "Setting Hostname and Saving Configuration",
  "deviceModel": "2960-switch",
  "goals": [
    {
      "section": "Basic Configuration",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter global configuration mode",
          "command": "configure terminal",
          "teachingPoint": "This is where you make changes to the device. Watch for the (config)# prompt."
        },
        {
          "objective": "Set the hostname to 'MySwitch'",
          "command": "hostname MySwitch",
          "teachingPoint": "The hostname appears in the prompt and helps identify your device in a network."
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end",
          "teachingPoint": "The 'end' command exits from any configuration mode directly to privileged mode."
        }
      ]
    },
    {
      "section": "Save Configuration",
      "steps": [
        {
          "objective": "Save configuration to memory",
          "command": "write memory",
          "teachingPoint": "CRITICAL: Cisco IOS does not save changes automatically! Always run 'write memory' to save your work."
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "hostname",
      "expectedValue": "MySwitch",
      "description": "Hostname should be set to 'MySwitch'",
      "diagnosticCommand": "show running-config"
    }
  ]
}

