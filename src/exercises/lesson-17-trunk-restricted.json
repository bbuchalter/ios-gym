{
  "id": "lesson-17-trunk-restricted",
  "title": "Trunk Ports: Restricting VLANs",
  "deviceModel": "3650-24ps",
  "goals": [
    {
      "section": "Configure Restricted Trunk Ports",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter configuration mode",
          "command": "configure terminal"
        },
        {
          "objective": "Configure GigabitEthernet 1/0/1",
          "command": "interface g1/0/1",
          "teachingPoint": "The 3650-24PS uses stackable naming: g1/0/x (stack 1, module 0, port x)"
        },
        {
          "objective": "Make it a trunk port",
          "command": "switchport mode trunk"
        },
        {
          "objective": "Restrict to VLANs 1,100,200",
          "command": "switchport trunk allowed vlan 1,100,200",
          "teachingPoint": "Best practice: only allow VLANs you actually need for security"
        },
        {
          "objective": "Exit interface configuration",
          "command": "exit"
        },
        {
          "objective": "Configure GigabitEthernet 1/0/2",
          "command": "interface g1/0/2"
        },
        {
          "objective": "Make it a trunk port",
          "command": "switchport mode trunk"
        },
        {
          "objective": "Restrict to VLANs 1,100,200",
          "command": "switchport trunk allowed vlan 1,100,200"
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end"
        },
        {
          "objective": "Save configuration",
          "command": "write memory"
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.g1/0/1.l2mode",
      "expectedValue": "trunk",
      "description": "GigabitEthernet 1/0/1 should be configured as a trunk port",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.g1/0/1.trunkAllowed",
      "expectedValue": "1,100,200",
      "description": "GigabitEthernet 1/0/1 should allow only VLANs 1,100,200",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.g1/0/2.l2mode",
      "expectedValue": "trunk",
      "description": "GigabitEthernet 1/0/2 should be configured as a trunk port",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.g1/0/2.trunkAllowed",
      "expectedValue": "1,100,200",
      "description": "GigabitEthernet 1/0/2 should allow only VLANs 1,100,200",
      "diagnosticCommand": "show running-config"
    }
  ]
}

