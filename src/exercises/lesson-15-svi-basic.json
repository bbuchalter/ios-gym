{
  "id": "lesson-15-svi-basic",
  "title": "SVI: Giving VLANs Their Own IP Address",
  "deviceModel": "3650-24ps",
  "goals": [
    {
      "section": "Basic Setup",
      "steps": [
        {
          "objective": "Enter privileged mode",
          "command": "enable"
        },
        {
          "objective": "Enter configuration mode",
          "command": "configure terminal"
        },
        {
          "objective": "Set hostname to 'CorporateDistributionSwitch1'",
          "command": "hostname CorporateDistributionSwitch1",
          "teachingPoint": "Professional naming helps identify devices in large networks"
        },
        {
          "objective": "Enable IP routing",
          "command": "ip routing",
          "teachingPoint": "This tells the switch to route packets between VLANs"
        }
      ]
    },
    {
      "section": "Create VLANs",
      "steps": [
        {
          "objective": "Create VLAN 100",
          "command": "vlan 100"
        },
        {
          "objective": "Exit VLAN configuration",
          "command": "exit"
        },
        {
          "objective": "Create VLAN 200",
          "command": "vlan 200"
        },
        {
          "objective": "Exit VLAN configuration",
          "command": "exit"
        }
      ]
    },
    {
      "section": "Configure SVIs",
      "steps": [
        {
          "objective": "Configure management SVI (VLAN 1)",
          "command": "interface vlan 1",
          "teachingPoint": "Management interface for SSH access to the switch"
        },
        {
          "objective": "Assign IP 172.16.16.1/24",
          "command": "ip address 172.16.16.1 255.255.255.0"
        },
        {
          "objective": "Enable the interface",
          "command": "no shutdown"
        },
        {
          "objective": "Exit interface configuration",
          "command": "exit"
        },
        {
          "objective": "Configure Student SVI (VLAN 100)",
          "command": "interface vlan 100",
          "teachingPoint": "This IP becomes the default gateway for student computers"
        },
        {
          "objective": "Assign IP 35.72.10.1/24",
          "command": "ip address 35.72.10.1 255.255.255.0"
        },
        {
          "objective": "Enable the interface",
          "command": "no shutdown"
        },
        {
          "objective": "Exit interface configuration",
          "command": "exit"
        },
        {
          "objective": "Configure Teacher SVI (VLAN 200)",
          "command": "interface vlan 200",
          "teachingPoint": "This IP becomes the default gateway for teacher computers"
        },
        {
          "objective": "Assign IP 33.2.169.1/24",
          "command": "ip address 33.2.169.1 255.255.255.0"
        },
        {
          "objective": "Enable the interface",
          "command": "no shutdown"
        },
        {
          "objective": "Exit to privileged mode",
          "command": "end"
        },
        {
          "objective": "Save configuration",
          "command": "write memory"
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "config-saved",
      "description": "Configuration must be saved with 'write memory'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "hostname",
      "expectedValue": "CorporateDistributionSwitch1",
      "description": "Hostname should be set to 'CorporateDistributionSwitch1'",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "ipRouting",
      "expectedValue": true,
      "description": "IP routing should be enabled",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "vlan-exists",
      "expectedValue": {
        "vlanId": "100"
      },
      "description": "VLAN 100 should exist",
      "diagnosticCommand": "show vlan brief"
    },
    {
      "type": "vlan-exists",
      "expectedValue": {
        "vlanId": "200"
      },
      "description": "VLAN 200 should exist",
      "diagnosticCommand": "show vlan brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.ip",
      "expectedValue": "172.16.16.1",
      "description": "VLAN 1 SVI should have IP 172.16.16.1",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.mask",
      "expectedValue": "255.255.255.0",
      "description": "VLAN 1 SVI should have mask 255.255.255.0",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan1.adminUp",
      "expectedValue": true,
      "description": "VLAN 1 SVI should be enabled",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan100.ip",
      "expectedValue": "35.72.10.1",
      "description": "VLAN 100 SVI should have IP 35.72.10.1",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan100.mask",
      "expectedValue": "255.255.255.0",
      "description": "VLAN 100 SVI should have mask 255.255.255.0",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan100.adminUp",
      "expectedValue": true,
      "description": "VLAN 100 SVI should be enabled",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan200.ip",
      "expectedValue": "33.2.169.1",
      "description": "VLAN 200 SVI should have IP 33.2.169.1",
      "diagnosticCommand": "show ip interface brief"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan200.mask",
      "expectedValue": "255.255.255.0",
      "description": "VLAN 200 SVI should have mask 255.255.255.0",
      "diagnosticCommand": "show running-config"
    },
    {
      "type": "state-path",
      "path": "interfaces.vlan200.adminUp",
      "expectedValue": true,
      "description": "VLAN 200 SVI should be enabled",
      "diagnosticCommand": "show ip interface brief"
    }
  ]
}

