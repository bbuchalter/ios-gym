#!/bin/sh
#
# Pre-commit hook for ios-practice
# Validates TypeScript types, tests pass, and build succeeds before allowing commit
#
# To install: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
#

echo "🔍 Running pre-commit checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo "${RED}✗ $1${NC}"
}

print_success() {
    echo "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo "${YELLOW}⚠ $1${NC}"
}

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
    print_error "package.json not found. Are you in the project root?"
    exit 1
fi

# Check grammar files are in sync
echo "📝 Checking grammar files are synchronized..."

# Check switch grammar (commands-2960-switch.yaml)
if [ -f "commands-2960-switch.yaml" ] && [ -f "web/public/commands-2960-switch.json" ]; then
    YAML_JSON=$(node -e "const yaml = require('js-yaml'); const fs = require('fs'); console.log(JSON.stringify(yaml.load(fs.readFileSync('commands-2960-switch.yaml', 'utf8')), null, 2));" 2>&1)
    if [ $? -ne 0 ]; then
        print_error "Failed to parse commands-2960-switch.yaml"
        echo "$YAML_JSON"
        exit 1
    fi
    
    CURRENT_JSON=$(cat web/public/commands-2960-switch.json)
    
    if [ "$YAML_JSON" != "$CURRENT_JSON" ]; then
        print_error "Switch grammar files are out of sync!"
        echo ""
        echo "commands-2960-switch.yaml and web/public/commands-2960-switch.json are not identical."
        echo "Run 'npm run build:grammar' to synchronize them."
        exit 1
    fi
    print_success "Switch grammar files (Catalyst 2960) are synchronized"
else
    print_warning "Switch grammar files not found, skipping check"
fi

# Check router grammar (commands-1941-router.yaml)
if [ -f "commands-1941-router.yaml" ] && [ -f "web/public/commands-1941-router.json" ]; then
    ROUTER_YAML_JSON=$(node -e "const yaml = require('js-yaml'); const fs = require('fs'); console.log(JSON.stringify(yaml.load(fs.readFileSync('commands-1941-router.yaml', 'utf8')), null, 2));" 2>&1)
    if [ $? -ne 0 ]; then
        print_error "Failed to parse commands-1941-router.yaml"
        echo "$ROUTER_YAML_JSON"
        exit 1
    fi
    
    ROUTER_CURRENT_JSON=$(cat web/public/commands-1941-router.json)
    
    if [ "$ROUTER_YAML_JSON" != "$ROUTER_CURRENT_JSON" ]; then
        print_error "Router grammar files are out of sync!"
        echo ""
        echo "commands-1941-router.yaml and web/public/commands-1941-router.json are not identical."
        echo "Run 'npm run build:grammar' to synchronize them."
        exit 1
    fi
    print_success "Router grammar files (Cisco 1941) are synchronized"
else
    print_warning "Router grammar files not found, skipping check"
fi

# Run TypeScript type checking
echo "🔍 Checking TypeScript types..."
if ! npx tsc --noEmit > /dev/null 2>&1; then
    print_error "TypeScript type checking failed!"
    echo ""
    echo "Run 'npx tsc --noEmit' to see the errors."
    exit 1
fi
print_success "TypeScript types are valid"

# Run tests
echo "🧪 Running tests..."
TEST_OUTPUT=$(./node_modules/.bin/jest --silent --passWithNoTests 2>&1)
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
    print_error "Tests failed!"
    echo ""
    echo "$TEST_OUTPUT" | tail -20
    echo ""
    echo "Run 'npm test' to see all failures."
    exit 1
fi
print_success "All tests passed"

# Check for linting errors in web directory
echo "🔎 Checking code style (web)..."
if ! (cd web && npm run lint > /dev/null 2>&1); then
    print_error "Web linting failed!"
    echo ""
    echo "Run 'cd web && npm run lint' to see the errors."
    echo "Tip: Use 'npm run lint -- --fix' to auto-fix some issues."
    exit 1
fi
print_success "Code style checks passed"

# Check code formatting with Prettier
echo "🎨 Checking code formatting..."
if ! (cd web && npm run format:check > /dev/null 2>&1); then
    print_error "Code formatting issues found!"
    echo ""
    echo "Run 'cd web && npm run format' to fix formatting."
    exit 1
fi
print_success "Code formatting is correct"

# Validate YAML syntax
echo "🔍 Validating YAML syntax..."
if ! npm run lint:yaml > /dev/null 2>&1; then
    print_error "YAML validation failed!"
    echo ""
    echo "Run 'npm run lint:yaml' to see errors."
    exit 1
fi
print_success "YAML files are valid"

echo ""
print_success "All pre-commit checks passed! 🎉"
echo ""

exit 0

